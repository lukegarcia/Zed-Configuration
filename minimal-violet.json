// ~/.config/zed/themes


{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Minimal Violet",
  "author": "You",
  "themes": [
    {
      "name": "Minimal Violet Light",
      "appearance": "light",
      "style": {
        "background.appearance": "opaque",
        /* ---------- Collaboration ---------- */
        "players": [
          {
            "cursor": "#8365ff",
            "background": "#8365ff20",
            "selection": "#8365ff30"
          }
        ],
        /* ---------- Global UI text & icons (medium gray works on both light and dark) ---------- */
        "text": "#c8ccd4",
        "text.muted": "#9ca2ad",
        "text.placeholder": "#7d848e",
        "text.disabled": "#6a707a",
        "text.accent": "#b89dff",
        "icon": "#c8ccd4",
        "icon.muted": "#9ca2ad",
        "icon.disabled": "#6a707a",
        "icon.placeholder": "#7d848e",
        "icon.accent": "#b89dff",
        /* ---------- Window chrome (dark backgrounds) ---------- */
        "title_bar.background": "#343d46",
        "title_bar.inactive_background": "#4a5362",
        "status_bar.background": "#343d46",
        "status_bar.border": "#8365ff",
        /* ---------- Structure & separators ---------- */
        "border": "#d0d4da",
        "border.variant": "#c0c4ca",
        "border.focused": "#8365ff",
        "border.selected": "#8365ff",
        "border.transparent": "#00000000",
        "border.disabled": "#e2e6ec",
        /* ---------- Surfaces (light backgrounds need darker text - override with experimental.theme_overrides) ---------- */
        "elevated_surface.background": "#ffffff",
        "surface.background": "#f3f5f7",
        "background": "#f3f5f7",
        /* ---------- Elements ---------- */
        "element.background": "#e8eaed",
        "element.hover": "#e0e3e8",
        "element.active": "#d4d7dc",
        "element.selected": "#e8e2ff",
        "element.disabled": "#f3f5f7",
        "drop_target.background": "#8365ff40",
        /* ---------- Ghost elements ---------- */
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#e0e3e840",
        "ghost_element.active": "#d4d7dc80",
        "ghost_element.selected": "#e8e2ff80",
        "ghost_element.disabled": "#f3f5f780",
        /* ---------- Editor ---------- */
        "editor.background": "#f3f5f7",
        "editor.gutter.background": "#f3f5f7",
        "editor.subheader.background": "#e2e6ec",
        "editor.active_line.background": "#eef0f3",
        "editor.highlighted_line.background": "#eef0f3",
        "editor.line_number": "#7d848e",
        "editor.active_line_number": "#111216",
        "editor.invisible": "#d0d4da",
        "editor.wrap_guide": "#e2e6ec",
        "editor.active_wrap_guide": "#d0d4da",
        "editor.document_highlight.read_background": "#e8e2ff80",
        "editor.document_highlight.write_background": "#e8e2ff",
        "editor.foreground": "#111216",
        /* ---------- Terminal ---------- */
        "terminal.background": "#f3f5f7",
        "terminal.foreground": "#111216",
        "terminal.bright_foreground": "#000000",
        "terminal.dim_foreground": "#7d848e",
        "terminal.ansi.black": "#1c2433",
        "terminal.ansi.bright_black": "#4a5e84",
        "terminal.ansi.dim_black": "#1c2433",
        "terminal.ansi.red": "#d16969",
        "terminal.ansi.bright_red": "#e07979",
        "terminal.ansi.dim_red": "#b85959",
        "terminal.ansi.green": "#608b4e",
        "terminal.ansi.bright_green": "#709b5e",
        "terminal.ansi.dim_green": "#507b3e",
        "terminal.ansi.yellow": "#d7ba7d",
        "terminal.ansi.bright_yellow": "#e7ca8d",
        "terminal.ansi.dim_yellow": "#c7aa6d",
        "terminal.ansi.blue": "#569cd6",
        "terminal.ansi.bright_blue": "#66ace6",
        "terminal.ansi.dim_blue": "#468cc6",
        "terminal.ansi.magenta": "#c586c0",
        "terminal.ansi.bright_magenta": "#d596d0",
        "terminal.ansi.dim_magenta": "#b576b0",
        "terminal.ansi.cyan": "#4ec9b0",
        "terminal.ansi.bright_cyan": "#5ed9c0",
        "terminal.ansi.dim_cyan": "#3eb9a0",
        "terminal.ansi.white": "#d4d4d4",
        "terminal.ansi.bright_white": "#e4e4e4",
        "terminal.ansi.dim_white": "#c4c4ca",
        /* ---------- Panels ---------- */
        "panel.background": "#e2e6ec",
        "panel.focused_border": "#8365ff",
        "pane.focused_border": "#8365ff",
        "toolbar.background": "#e2e6ec",
        "tab_bar.background": "#f3f5f7",
        "tab.inactive_background": "#e8eaed",
        "tab.active_background": "#f3f5f7",
        /* ---------- Search ---------- */
        "search.match_background": "#e8e2ff",
        /* ---------- Scrollbar ---------- */
        "scrollbar.thumb.background": "#d0d4da80",
        "scrollbar.thumb.hover_background": "#c0c4caa0",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#e2e6ec",
        /* ---------- Git ---------- */
        "conflict": "#d16969",
        "conflict.background": "#d1696920",
        "conflict.border": "#d16969",
        "created": "#608b4e",
        "created.background": "#608b4e20",
        "created.border": "#608b4e",
        "deleted": "#d16969",
        "deleted.background": "#d1696920",
        "deleted.border": "#d16969",
        "error": "#d16969",
        "error.background": "#d1696920",
        "error.border": "#d16969",
        "hidden": "#7d848e",
        "hidden.background": "#7d848e20",
        "hidden.border": "#7d848e",
        "hint": "#5d67b4",
        "hint.background": "#5d67b420",
        "hint.border": "#5d67b4",
        "ignored": "#7d848e",
        "ignored.background": "#7d848e20",
        "ignored.border": "#7d848e",
        "info": "#5d67b4",
        "info.background": "#5d67b420",
        "info.border": "#5d67b4",
        "modified": "#d7ba7d",
        "modified.background": "#d7ba7d20",
        "modified.border": "#d7ba7d",
        "predictive": "#7d848e80",
        "predictive.background": "#7d848e20",
        "predictive.border": "#7d848e",
        "renamed": "#569cd6",
        "renamed.background": "#569cd620",
        "renamed.border": "#569cd6",
        "success": "#608b4e",
        "success.background": "#608b4e20",
        "success.border": "#608b4e",
        "unreachable": "#7d848e",
        "unreachable.background": "#7d848e20",
        "unreachable.border": "#7d848e",
        "warning": "#d7ba7d",
        "warning.background": "#d7ba7d20",
        "warning.border": "#d7ba7d",
        /* ---------- Syntax: neutrals + violet accent; selective bold ---------- */
        "syntax": {
          "attribute": {
            "color": "#5d67b4"
          },
          "boolean": {
            "color": "#5d67b4"
          },
          "comment": {
            "color": "#8a8f98"
          },
          "comment.doc": {
            "color": "#8a8f98"
          },
          "constant": {
            "color": "#5d67b4"
          },
          "constructor": {
            "color": "#3a3d44"
          },
          "embedded": {
            "color": "#111216"
          },
          "emphasis": {
            "color": "#5d67b4"
          },
          "emphasis.strong": {
            "color": "#5d67b4",
            "font_weight": 700
          },
          "enum": {
            "color": "#5d67b4"
          },
          "function": {
            "color": "#3a3d44",
            "font_weight": 600
          },
          "hint": {
            "color": "#5d67b4",
            "font_weight": 700
          },
          "keyword": {
            "color": "#8365ff",
            "font_weight": 600
          },
          "label": {
            "color": "#5d67b4"
          },
          "link_text": {
            "color": "#5d67b4",
            "font_style": "italic"
          },
          "link_uri": {
            "color": "#5d67b4"
          },
          "number": {
            "color": "#5d67b4"
          },
          "operator": {
            "color": "#3a3d44"
          },
          "predictive": {
            "color": "#7d848e80",
            "font_style": "italic"
          },
          "preproc": {
            "color": "#111216"
          },
          "primary": {
            "color": "#111216"
          },
          "property": {
            "color": "#111216"
          },
          "punctuation": {
            "color": "#3a3d44"
          },
          "punctuation.bracket": {
            "color": "#3a3d44"
          },
          "punctuation.delimiter": {
            "color": "#3a3d44"
          },
          "punctuation.list_marker": {
            "color": "#3a3d44"
          },
          "punctuation.special": {
            "color": "#3a3d44"
          },
          "string": {
            "color": "#4a4f59"
          },
          "string.escape": {
            "color": "#5d67b4"
          },
          "string.regex": {
            "color": "#4a4f59"
          },
          "string.special": {
            "color": "#5d67b4"
          },
          "string.special.symbol": {
            "color": "#5d67b4"
          },
          "tag": {
            "color": "#8365ff"
          },
          "text.literal": {
            "color": "#4a4f59"
          },
          "title": {
            "color": "#3a3d44",
            "font_weight": 700
          },
          "type": {
            "color": "#5d67b4",
            "font_weight": 600
          },
          "variable": {
            "color": "#111216"
          },
          "variable.special": {
            "color": "#8365ff"
          },
          "variant": {
            "color": "#5d67b4"
          }
        }
      }
    }
  ]
}
